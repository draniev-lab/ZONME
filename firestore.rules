rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isAdmin() {
      if (!isSignedIn()) {
        return false;
      }
      // La lecture des profils étant autorisée pour tous les utilisateurs connectés,
      // cette fonction peut maintenant s'exécuter sans problème de permission.
      let role = getUserData(request.auth.uid).role;
      return role == 'admin' || role == 'Admin';
    }
    
    function isAgentForOwner(propertyOwnerId) {
      let ownerProfile = getUserData(propertyOwnerId);
      // Utilisation de .get() pour éviter les erreurs si agencyId n'existe pas.
      let agencyId = ownerProfile.get('agencyId', null);
      if (agencyId == null) {
        return false;
      }
      let agency = get(/databases/$(database)/documents/agencies/$(agencyId)).data;
      // agentIds est une map, on vérifie la présence de la clé.
      return isSignedIn() && request.auth.uid in agency.agentIds;
    }

    // --- User Profiles ---
    match /users/{userId} {
      // TOUT utilisateur connecté peut lire les profils. C'est nécessaire pour la logique de rôle.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      // Un utilisateur peut mettre à jour son propre profil, SAUF le rôle et le statut de vérification.
      allow update: if isOwner(userId) && !('role' in request.resource.data) && !('isVerified' in request.resource.data);
      // Un admin peut mettre à jour le profil de n'importe qui, y compris le rôle et le statut de vérification.
      allow update: if isAdmin();
      allow list: if isAdmin();
    }

    // --- Properties ---
    match /properties/{propertyId} {
      allow read: if resource.data.validated == true || 
                  (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin() || isAgentForOwner(resource.data.ownerId)));
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.validated == false;
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin() || isAgentForOwner(resource.data.ownerId));
    }

    // --- Messages ---
    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
    }

    // --- Visit Requests ---
    match /visitRequests/{visitRequestId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.ownerId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == resource.data.ownerId || isAgentForOwner(resource.data.ownerId) || isAdmin());
    }

    // --- Agencies ---
    match /agencies/{agencyId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isSignedIn(); // N'importe quel user peut lire les infos d'une agence
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // --- User Documents (KYC) ---
    match /userDocuments/{documentId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // --- Activity Logs ---
    match /activityLogs/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isAdmin();
    }

    // --- Global Settings ---
    match /settings/app {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- Stripe Payments Extension ---
    match /customers/{userId}/checkout_sessions/{sessionId} {
      allow create, read, update: if isSignedIn() && isOwner(userId);
    }
    match /products/{productId} {
      allow read: if true;
      match /prices/{priceId} {
         allow read: if true;
      }
    }
  }
}
